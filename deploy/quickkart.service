[Unit]
Description=QuickKart FastAPI Quick Commerce Application
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Quickkart
Environment="PATH=/home/ubuntu/Quickkart/venv/bin"
ExecStart=/home/ubuntu/Quickkart/venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
